{
  "name": "@ai-gate/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:routes": "node tests/run-api-batch.mjs tests/routes.jsonl tests/routes.app.mjs && node --import tsx --test tests/routes-integrity.test.mjs",
    "test:routing-schema": "node --import tsx --test tests/routing-schema.test.mjs",
    "test:virtual-models": "node tests/run-api-batch.mjs tests/virtual-models.jsonl tests/virtual-models.app.mjs && node tests/run-api-batch.mjs tests/virtual-models-edge.jsonl tests/virtual-models.app.mjs",
    "test:provider-urls": "node tests/run-api-batch.mjs tests/provider-urls.jsonl tests/provider-urls.app.mjs",
    "test:models": "node tests/run-api-batch.mjs tests/model-types.jsonl tests/model-types.app.mjs",
    "test:api": "node tests/run-api-batch.mjs tests/api-namespaces.jsonl tests/model-types.app.mjs"
  },
  "dependencies": {
    "@ai-gate/shared": "workspace:*",
    "@hono/node-server": "catalog:",
    "@hono/valibot-validator": "catalog:",
    "better-sqlite3": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@hono/cli": "1.0.0-rc.8",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
