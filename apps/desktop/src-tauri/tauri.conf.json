{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-gate",
  "version": "0.1.0",
  "identifier": "cn.acegain.ai-gate",
  "build": {
    "beforeDevCommand": "pnpm --parallel --filter @ai-gate/server --filter @ai-gate/web dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --filter @ai-gate/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Gate",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
