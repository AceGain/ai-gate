{
  "name": "ai-gate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:all": "concurrently -k -n api,web -c blue,green \"pnpm dev:api < NUL\" \"pnpm dev\"",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p server/tsconfig.json --noEmit",
    "generate:brand-icons": "node scripts/generate-brand-icons.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@iconify-json/lucide": "^1.2.123",
    "@lobehub/icons-static-png": "^1.95.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/ui": "^4.11.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "hono": "^4.13.5",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@lobehub/icons": "^5.16.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.10"
  }
}
