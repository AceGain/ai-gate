{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-gate",
  "version": "0.1.0",
  "identifier": "cn.acegain.aigate",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm generate",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Gate",
        "width": 1168,
        "height": 769,
        "minWidth": 976,
        "minHeight": 649,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
